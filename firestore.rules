rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helper: Note
    function isValidNote(data, userId, noteId) {
      return data.id is string && data.id == noteId && isValidId(data.id) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 50000 &&
             data.folderId is string && data.folderId.size() <= 128 &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
             data.checklistItems is list && data.checklistItems.size() <= 50 &&
             (data.checklistItems.size() == 0 || (data.checklistItems[0] is string && data.checklistItems[0].size() <= 500)) &&
             data.isPinned is bool &&
             data.isArchived is bool &&
             data.isTrashed is bool &&
             data.isLocked is bool &&
             data.colorKey is string && data.colorKey.size() >= 1 && data.colorKey.size() <= 40 &&
             data.voiceTranscript is string && data.voiceTranscript.size() <= 10000 &&
             data.voiceDurationSec is int && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 86400 &&
             data.reminderAtMillis is int && data.reminderAtMillis >= 0 &&
             data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Helper: Folder
    function isValidFolder(data, userId, folderId) {
      return data.id is string && data.id == folderId && isValidId(data.id) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.accentKey is string && data.accentKey.size() >= 1 && data.accentKey.size() <= 40 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && existing().userId == request.auth.uid;
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(noteId) &&
                       incoming().keys().hasAll([
                         'id', 'userId', 'title', 'content', 'folderId', 'tags',
                         'checklistItems', 'isPinned', 'isArchived', 'isTrashed',
                         'isLocked', 'colorKey', 'voiceTranscript', 'voiceDurationSec',
                         'reminderAtMillis', 'wordCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'id', 'userId', 'title', 'content', 'folderId', 'tags',
                         'checklistItems', 'isPinned', 'isArchived', 'isTrashed',
                         'isLocked', 'colorKey', 'voiceTranscript', 'voiceDurationSec',
                         'reminderAtMillis', 'wordCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidNote(incoming(), userId, noteId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(noteId) &&
                       isValidNote(incoming(), userId, noteId) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'content', 'folderId', 'tags', 'checklistItems',
                         'isPinned', 'isArchived', 'isTrashed', 'isLocked', 'colorKey',
                         'voiceTranscript', 'voiceDurationSec', 'reminderAtMillis',
                         'wordCount', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && existing().userId == request.auth.uid;
    }

    match /users/{userId}/folders/{folderId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(folderId) && existing().userId == request.auth.uid;
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(folderId) &&
                       incoming().keys().hasAll([
                         'id', 'userId', 'name', 'iconKey', 'accentKey',
                         'sortOrder', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'id', 'userId', 'name', 'iconKey', 'accentKey',
                         'sortOrder', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFolder(incoming(), userId, folderId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(folderId) &&
                       isValidFolder(incoming(), userId, folderId) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'iconKey', 'accentKey', 'sortOrder', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(folderId) && existing().userId == request.auth.uid;
    }
  }
}
